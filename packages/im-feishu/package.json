{
  "name": "dsh-orgos-im-feishu",
  "version": "0.1.0",
  "description": "dsh-orgos 飞书/Lark WebSocket 适配器:入站事件规范化、任务卡/决策卡/审批卡渲染、长消息分段、重连退避(harness-agnostic)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dsh": {
      "types": "./lib/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "author": "shisan13",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "dsh-orgos-im-gateway": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}