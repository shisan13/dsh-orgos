{
  "name": "dsh-orgos-doc-feishu-docs",
  "version": "0.1.0",
  "description": "dsh-orgos 飞书云文档(docx)文档 provider:团队知识目录/文档协作的 Feishu Docx 落地(harness-agnostic 协议层 + DSH 绑定层)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dsh": {
      "types": "./lib/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "author": "shisan13",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dsh-orgos-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shisan13/dsh-orgos.git"
  }
}
